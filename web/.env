# Frontend Environment Variables for Development

# Backend API Configuration
# Update this URL to your deployed backend service URL
# For local development, use: http://localhost:3001
# For production, use: https://merch-manager-backend-[hash]-uc.a.run.app
VITE_API_BASE_URL=https://merch-manager-backend-361151780407.us-central1.run.app
VITE_API_TIMEOUT=30000
VITE_REQUEST_TIMEOUT=120000

# Application Configuration
VITE_APP_NAME=Merch Manager
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development
VITE_BUILD_TIMESTAMP=1749970740

# Google Cloud Configuration
VITE_GOOGLE_CLOUD_PROJECT_ID=neon-vigil-395120
VITE_GOOGLE_CLOUD_REGION=us-central1
VITE_GOOGLE_MERCHANT_ID=your-merchant-id

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_COMPETITIVE_PRICING=true
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_CUSTOM_FIELDS=true
VITE_ENABLE_GROUNDED_SOURCES=true
VITE_ENABLE_BULK_OPERATIONS=true
VITE_ENABLE_ANALYTICS=true

# UI Configuration
VITE_THEME_MODE=light
VITE_ENABLE_DARK_MODE=true
VITE_PAGINATION_SIZE=25
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp

# Performance Configuration
VITE_CACHE_TIMEOUT=300000
VITE_DEBOUNCE_DELAY=500
VITE_AUTO_SAVE_INTERVAL=30000

# Debug Configuration
VITE_DEBUG_MODE=true
VITE_VERBOSE_LOGGING=true
VITE_ENABLE_CONSOLE_LOGS=true

# External Services
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# URLs and Links
VITE_DOCUMENTATION_URL=https://developers.google.com/merchant/api
