# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
# DO NOT commit actual service account keys - use Google Cloud Run service account instead
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account-key.json

# Google Merchant Center Configuration
GOOGLE_MERCHANT_ID=your-merchant-id

# Google Gemini API Configuration
# Store this securely in Google Secret Manager for production
GEMINI_API_KEY=your-gemini-api-key

# API Configuration
MERCHANT_API_BASE_URL=https://merchantapi.googleapis.com
MERCHANT_API_VERSION=v1beta
REQUIRED_SCOPES=https://www.googleapis.com/auth/content

# Server Configuration
PORT=3001
# Update this for your frontend URL
CORS_ORIGIN=http://localhost:5174

# Security Note:
# - Never commit .env files with real credentials
# - Use Google Cloud Secret Manager for production secrets
# - Use Google Cloud Run service accounts for authentication
