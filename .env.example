# Application Environment
NODE_ENV=development
APP_NAME=merch-manager-backend
APP_VERSION=1.0.0

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account-key.json
GOOGLE_CLOUD_REGION=us-central1

# Google Merchant Center Configuration
GOOGLE_MERCHANT_ID=your-merchant-id
MERCHANT_API_BASE_URL=https://merchantapi.googleapis.com
MERCHANT_API_VERSION=v1beta
REQUIRED_SCOPES=https://www.googleapis.com/auth/content

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TIMEOUT=30000

# Server Configuration
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true
REQUEST_TIMEOUT=120000
REQUEST_SIZE_LIMIT=10mb

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=combined
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_LOGGING=true

# Security Configuration
HELMET_ENABLED=true
COMPRESSION_ENABLED=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
DEMO_MODE=false
AI_CONTENT_ENABLED=true
COMPETITIVE_PRICING_ENABLED=true
REVIEWS_ENABLED=true
ANALYTICS_ENABLED=false

# Performance Configuration
MAX_CONCURRENT_REQUESTS=50
PYTHON_SCRIPT_TIMEOUT=45000
CACHE_TTL=3600

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
READINESS_CHECK_ENABLED=true

# Development/Debug Configuration
DEBUG_MODE=false
VERBOSE_LOGGING=false
ENABLE_STACK_TRACES=true

# External Service Configuration
PYTHON_EXECUTABLE=python3
AI_CONTENT_SCRIPT_PATH=./src/scripts/ai_content_generator.py
COMPETITIVE_PRICING_SCRIPT_PATH=./src/scripts/competitive_pricing_analyzer.py
